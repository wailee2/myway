# Public site URL (used for metadata). No secrets live in this MVP.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One switch for every prototype-only feature: demo accounts, "move the trip along" controls,
# sample demand numbers, demo OTP notes and seeded history. Anything but "false" keeps it on.
NEXT_PUBLIC_DEMO=true

# Where "Email us" / "Call" go on the Help screen. Left empty, those buttons are hidden.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# Where the Next.js server forwards /api/* (the FastAPI backend). `npm run dev` at the repo root starts it on :8000.
API_URL=http://localhost:8000

# true (default): sign-up, login and ID checks go to the FastAPI backend. false: run the frontend alone on local demo data.
NEXT_PUBLIC_LIVE_API=true
